  m_Script: {fileID: 11500000, guid: 29285a86e2f6b814fa40be88e294e3ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryQuiz
  title: "\uAE30\uC5B5 \uD034\uC988"
  question: "2\uCE35\uC5D0 \uC804\uC2DC\uB41C \uADF8\uB9BC\uB4E4\uC744 \uB5A0\uC62C\uB9AC\uBA70,
    \uBB34\uC5C7\uC774 \uB2EC\uB77C\uC84C\uB294\uC9C0 \uB9DE\uD788\uC138\uC694."
  questions:
  - text: "\uBC14\uB098\uB098 \uADF8\uB9BC\uC5D0\uC11C \uB2EC\uB77C\uC9C4 \uAC83\uC740?"
    choices:
    - "\uBC14\uB098\uB098 \uC78E\uC774 \uCD08\uB85D\uC0C9\uC5D0\uC11C \uB178\uB780\uC0C9\uC774
      \uB418\uC5C8\uB2E4"
    - "\uC778\uBB3C\uC758 \uD45C\uC815\uC774 \uC6C3\uB294 \uC5BC\uAD74\uC774 \uB418\uC5C8\uB2E4"
    - "\uBC14\uB098\uB098 \uAC1C\uC218\uAC00 \uC904\uC5C8\uB2E4"
    answerIndex: 0
  - text: "\uB178\uB780 \uC6B0\uC0B0\uC744 \uB4E0 \uC5EC\uC790 \uADF8\uB9BC\uC5D0\uC11C
      \uB2EC\uB77C\uC9C4 \uAC83\uC740?"
    choices:
    - "\uC6B0\uC0B0 \uC0C9\uC774 \uD30C\uB780\uC0C9\uC774 \uB418\uC5C8\uB2E4"
    - "\uB4A4\uCABD \uBC30\uACBD \uC0C9\uC774 \uBC14\uB00C\uC5C8\uB2E4"
    - "\uB2EC\uC774 \uC0AC\uB77C\uC84C\uB2E4"
    answerIndex: 1
  - text: "\uBC31\uC870 \uADF8\uB9BC\uC5D0\uC11C \uB2EC\uB77C\uC9C4 \uAC83\uC740?"
    choices:
    - "\uBC31\uC870\uAC00 \uC138 \uB9C8\uB9AC\uAC00 \uB418\uC5C8\uB2E4"
    - "\uD638\uC218\uAC00 \uC5BC\uC5B4\uBD99\uC5C8\uB2E4"
    - "\uD55C \uB9C8\uB9AC\uAC00 \uBC18\uB300\uCABD\uC744 \uBCF4\uACE0 \uC788\uB2E4"
    answerIndex: 2
  - text: "\uBE44\uB217\uBC29\uC6B8 \uADF8\uB9BC\uC5D0\uC11C \uB2EC\uB77C\uC9C4 \uAC83\uC740?"
    choices:
    - "\uB3D9\uADF8\uB780 \uBE44\uB217\uBC29\uC6B8\uC774 \uC0AC\uB77C\uC84C\uB2E4"
    - "\uAC15\uC544\uC9C0 \uBB34\uB2AC\uAC00 \uBC14\uB00C\uC5C8\uB2E4"
    - "\uC544\uC774\uC758 \uBAA8\uC790\uAC00 \uC0AC\uB77C\uC84C\uB2E4"
    answerIndex: 0
  - text: "\uD638\uC22B\uAC00\uC758 \uC606\uBAA8\uC2B5 \uC5EC\uC790 \uADF8\uB9BC\uC5D0\uC11C
      \uB2EC\uB77C\uC9C4 \uAC83\uC740?"
    choices:
    - "\uC815\uBA74\uC744 \uBCF4\uAC8C \uB418\uC5C8\uB2E4"
    - "\uD480\uC5B4 \uB0B4\uB9B0 \uBA38\uB9AC\uAC00 \uBC18\uBB36\uC74C\uC774 \uB418\uC5C8\uB2E4"
    - "\uD638\uC218\uC5D0 \uBC30\uAC00 \uC0DD\uACBC\uB2E4"
    answerIndex: 1
  passCount: 4
  variants: []
